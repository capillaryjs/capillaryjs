{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@sylwellsoftware/glue": ["packages/glue/src/index.ts"],
      "@sylwellsoftware/fray": ["packages/fray/src/index.ts"],
      "@sylwellsoftware/fray/jsx-runtime": ["packages/fray/src/jsx-runtime.ts"],
      "@sylwellsoftware/fray/jsx-dev-runtime": ["packages/fray/src/jsx-dev-runtime.ts"],
      "@sylwellsoftware/fray-visualization": ["packages/fray-visualization/src/index.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "@sylwellsoftware/fray",
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "vite.config.ts", "playwright.config.ts"]
}
