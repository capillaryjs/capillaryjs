{
  "name": "@sylwellsoftware/buildco-control",
  "private": true,
  "version": "0.1.0",
  "description": "Construction operations demo for Glue, Fray and Fray Visualization.",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=22.6", "pnpm": ">=10" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --import tsx src/server/start.ts",
    "test:ui": "playwright test",
    "test:http": "node --import tsx --test test/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:demo": "node --import tsx --test test/scenarios/*.test.ts",
    "verify": "pnpm typecheck && pnpm test",
    "scenario": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@sylwellsoftware/fray": "workspace:^",
    "@sylwellsoftware/fray-visualization": "workspace:^",
    "@sylwellsoftware/glue": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^6.4.3"
  }
}
