{
  "type": "module",
  "name": "@sylwellsoftware/fray-visualization",
  "private": false,
  "version": "0.4.0",
  "description": "Reactive analytical controls, block mosaics, and history charts for Fray applications.",
  "license": "Apache-2.0",
  "author": {
    "name": "Sylwell Software",
    "email": "npm@sylwellsoftware.com",
    "url": "https://sylwellsoftware.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylwellsoftware/gluefrayjs.git",
    "directory": "packages/fray-visualization"
  },
  "homepage": "https://github.com/sylwellsoftware/gluefrayjs#readme",
  "bugs": {
    "url": "https://github.com/sylwellsoftware/gluefrayjs/issues"
  },
  "keywords": [
    "charts",
    "fray",
    "reactive",
    "treemap",
    "typescript",
    "visualization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/structural.css": "./styles/structural.css"
  },
  "files": [
    "dist",
    "styles",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "./styles/*.css"
  ],
  "scripts": {
    "build": "pnpm build:styles && vite build && tsc -p tsconfig.build.json",
    "build:styles": "node --import tsx scripts/build-structural-css.mjs",
    "prepack": "pnpm typecheck && pnpm test && pnpm build && pnpm test:types:consumer",
    "test": "node --import tsx --test test/*.test.ts",
    "test:types:consumer": "tsc -p test-types/consumer/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "vite build --watch"
  },
  "peerDependencies": {
    "@sylwellsoftware/fray": "^0.4.0",
    "@sylwellsoftware/glue": "^0.4.0"
  },
  "devDependencies": {
    "@sylwellsoftware/fray": "^0.4.0",
    "@sylwellsoftware/glue": "^0.4.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.11.0"
}
