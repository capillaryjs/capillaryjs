{
  "name": "@capillaryjs/capillary",
  "private": false,
  "version": "1.0.0",
  "description": "Platform-neutral reactive values, derived state, live queries, and causal tracing.",
  "license": "Apache-2.0",
  "author": {
    "name": "Sylwell Software",
    "email": "npm@sylwellsoftware.com",
    "url": "https://sylwellsoftware.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capillaryjs/capillaryjs.git",
    "directory": "packages/capillary"
  },
  "homepage": "https://github.com/capillaryjs/capillaryjs#readme",
  "bugs": {
    "url": "https://github.com/capillaryjs/capillaryjs/issues"
  },
  "keywords": [
    "reactive",
    "state-management",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "pnpm typecheck && pnpm test && pnpm build && pnpm test:types:consumer",
    "test": "node --import tsx --test test/*.test.ts",
    "test:types:consumer": "tsc -p test-types/consumer/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "vite build --watch"
  },
  "type": "module",
  "devDependencies": {
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.11.0"
}
